{
  "name": "vue-ws-link",
  "version": "1.0.0",
  "description": "Reusable WebSocket client and Vue 3 composable with heartbeat and reconnect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longyunmo/vue-ws-link.git"
  },
  "homepage": "https://github.com/longyunmo/vue-ws-link#readme",
  "bugs": {
    "url": "https://github.com/longyunmo/vue-ws-link/issues"
  },
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.umd.cjs" }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && vue-tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": { "vue": "^3.3.0" },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
